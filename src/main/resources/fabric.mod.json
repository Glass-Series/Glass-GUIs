{
  "schemaVersion": 1,
  "id": "glassguis",
  "version": "${version}",

  "name": "Glass GUIs",
  "description": "A total conversion mod aiming to add new features and revitalize beta 1.7.3. Incompatible with everything, including StationAPI.",
  "authors": [
    "calmilamsy"
  ],
  "contact": {
    "homepage": "https://glass-launcher.net/",
    "sources": "https://github.com/Glass-Series/Glass-GUIs"
  },

  "license": "CC0-1.0",
  "icon": "assets/glassguis/icon.png",

  "environment": "*",
  "entrypoints": {
    "stationapi:event_bus": [
      "net.glasslauncher.mods.glassguis.events.init.GlassGUIs"
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ],
    "glassnetworking": [
      "net.glasslauncher.mods.glassguis.events.init.GlassGUIsPackets"
    ]
  },
  "mixins": [
    "glassguis.mixins.json"
  ],
  "accessWidener": "glassguis.accesswidener",

  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/client/gui/screen/Screen": ["net/glasslauncher/mods/glassguis/screen/GlassScreen"],
      "net/minecraft/screen/ScreenHandler": ["net/glasslauncher/mods/glassguis/screen/GlassScreenHandler"]
    }
  },

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
